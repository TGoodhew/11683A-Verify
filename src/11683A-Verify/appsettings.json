{
  // Shared defaults. Put bench-specific values (GPIB address, DVM serial and cal date) in
  // appsettings.local.json next to this file; it overrides these and git ignores it.
  "company": "The Schnauzer Group LLC",
  "operator": "",

  "calibrator": {
    "model": "11683A",
    "serial": "SG52060005",
    "options": "H01"
  },

  "dvm": {
    // 34401A or 3458A
    "model": "34401A",
    // 22 is the 34401A factory default address.
    "resource": "GPIB0::22::INSTR",
    "serial": "",
    // yyyy-MM-dd, e.g. "2026-03-14"
    "calibrationDate": null,
    "calibrationIntervalMonths": 12,
    "timeoutMs": 20000,
    // Spec-table column used for the uncertainty: 24h, 90d, 1y or 2y
    "specPeriod": "1y"
  },

  "measurement": {
    "lineFrequencyHz": 60,
    "nplc": 100,
    "readingsPerPoint": 10
  },

  "resultsDirectory": "results"
}

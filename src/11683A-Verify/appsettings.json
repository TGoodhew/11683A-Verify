{
  // Shared defaults. Put bench-specific values (GPIB address, DVM serial and cal date) in
  // appsettings.local.json next to this file; it overrides these and git ignores it.
  "company": "The Schnauzer Group LLC",
  "operator": "",

  "calibrator": {
    "model": "11683A",
    "serial": "SG52060005",
    "options": "H01"
  },

  "dvm": {
    // 34401A or 3458A
    "model": "34401A",
    // 22 is the 34401A factory default address.
    "resource": "GPIB0::22::INSTR",
    "serial": "",
    // yyyy-MM-dd, e.g. "2026-03-14"
    "calibrationDate": null,
    "calibrationIntervalMonths": 12,
    "timeoutMs": 20000,
    // Spec-table column used for the uncertainty: 24h, 90d, 1y or 2y
    "specPeriod": "1y"
  },

  "measurement": {
    "lineFrequencyHz": 60,
    "nplc": 100,
    "readingsPerPoint": 10,
    // A point is settled when every reading over the hold time is within ±band of their mean
    // (band = this many ppm of reading, with floors of 2 uV and 2 mOhm).
    "settlingBandPpm": 20,
    "settlingHoldSeconds": 10,
    "settlingTimeoutSeconds": 120
  },

  "warmup": {
    // Minutes the 11683A must be on before testing; the DVM's warm-up comes from its spec table
    "calibratorMinutes": 30
  },

  "uncertainty": {
    // U = k * u_c, with the DVM spec treated as rectangular (spec / sqrt 3)
    "coverageFactor": 2,
    // Rss (default) or Linear (worst case) for the two readings of a ratio
    "ratioCombination": "Rss",
    // Points with a test uncertainty ratio below this are flagged
    "minimumTur": 4
  },

  "resultsDirectory": "results"
}

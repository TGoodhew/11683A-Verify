        {
          "label": "30 mW",
          "calibrator": {
            "range": "30mW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 31.6,
          "unit": "mW",
          "min": 31.4,
          "max": 31.8

    {
      "id": "instrument-accuracy",
      "title": "Instrument Accuracy Test",
      "source": "437B-UM.pdf, para 4-8, pp. 4-5 to 4-7 (PDF pp. 143-145); Table 4-1 p. 4-12 (PDF p. 150)",
      "reading": "Meter",
      "equipment": [
        "HP 11683A Range Calibrator",
        "HP 11730A power sensor cable"
      ],
      "setup": [
        "Connect as Figure 4-2. 437B LINE ON, PRESET/LOCAL then ENTER, dBm/W for watts.",
        "11683A: FUNCTION STANDBY, POLARITY NORMAL, RANGE 3 µW, LINE ON. Wait for the downward drift to stop (typically under 60 s).",
        "Press ZERO; the display should read 0.00 ±0.05 µW.",
        "11683A FUNCTION CALIBRATE, RANGE 1 mW. Press CAL (SHIFT ZERO), set REF CF 100.0%, ENTER (CAL*** shows).",
        "Press CAL FAC (SHIFT FREQ), set 100.0%, ENTER. The display should read 1.000 ±0.001 mW.",
        "Set the 11683A RANGE to each row."
      ],
      "meter": {
        "display": "Watts",
        "range": 0,
        "filter": 0
      },
      "zero": {
        "calibrator": {
          "range": "3uW",
          "function": "Standby",
          "polarity": "Normal"
        },
        "settleSeconds": 60
      },
      "cal": {
        "calibrator": {
          "range": "1mW",
          "function": "Calibrate",
          "polarity": "Normal"
        },
        "referenceCalFactorPercent": 100
      },
      "points": [
        {
          "label": "3 µW",
          "calibrator": {
            "range": "3uW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 3.16,
          "unit": "uW",
          "min": 3.1,
          "max": 3.23
        },
        {
          "label": "10 µW",
          "calibrator": {
            "range": "10uW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 10,
          "unit": "uW",
          "min": 9.9,
          "max": 10.1
        },
        {
          "label": "30 µW",
          "calibrator": {
            "range": "30uW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 31.6,
          "unit": "uW",
          "min": 31.4,
          "max": 31.8
        },
        {
          "label": "100 µW",
          "calibrator": {
            "range": "100uW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 100,
          "unit": "uW",
          "min": 99.5,
          "max": 100.5
        },
        {
          "label": "300 µW",
          "calibrator": {
            "range": "300uW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 0.316,
          "unit": "mW",
          "min": 0.314,
          "max": 0.318
        },
        {
          "label": "1 mW",
          "calibrator": {
            "range": "1mW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 1,
          "unit": "mW",
          "min": 0.995,
          "max": 1.005
        },
        {
          "label": "3 mW",
          "calibrator": {
            "range": "3mW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 3.16,
          "unit": "mW",
          "min": 3.14,
          "max": 3.18
        },
        {
          "label": "10 mW",
          "calibrator": {
            "range": "10mW",
            "function": "Calibrate",
            "polarity": "Normal"
          },
          "meterSetting": "Watts, autorange",
          "expected": 10,
          "unit": "mW",
          "min": 9.95,
          "max": 10.05
